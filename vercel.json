{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/process.html",
      "destination": "/process/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/request-service.html",
      "destination": "/request/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/careers.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/research-proposal.html",
      "destination": "/services/research-consulting/",
      "permanent": true
    },
    {
      "source": "/services/statistical-analysis.html",
      "destination": "/services/statistical-analysis/",
      "permanent": true
    },
    {
      "source": "/services/proofreading.html",
      "destination": "/services/editing/",
      "permanent": true
    },
    {
      "source": "/services/formatting.html",
      "destination": "/services/formatting-references/",
      "permanent": true
    },
    {
      "source": "/services/education.html",
      "destination": "/fields/education/",
      "permanent": true
    },
    {
      "source": "/services/management.html",
      "destination": "/fields/management/",
      "permanent": true
    },
    {
      "source": "/services/hr.html",
      "destination": "/fields/hr/",
      "permanent": true
    },
    {
      "source": "/services/accounting.html",
      "destination": "/fields/accounting/",
      "permanent": true
    },
    {
      "source": "/services/it.html",
      "destination": "/fields/computing/",
      "permanent": true
    },
    {
      "source": "/blog/apa-citation-guide.html",
      "destination": "/blog/apa-citation-guide/",
      "permanent": true
    },
    {
      "source": "/blog/choose-research-topic.html",
      "destination": "/blog/choose-research-topic/",
      "permanent": true
    },
    {
      "source": "/blog/statistical-analysis-basics.html",
      "destination": "/blog/statistical-analysis-basics/",
      "permanent": true
    },
    {
      "source": "/images/hero.webp",
      "destination": "/og/default.png",
      "permanent": true
    },
    {
      "source": "/images/why-us.webp",
      "destination": "/og/default.png",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

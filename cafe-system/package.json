{
  "name": "cafe-system",
  "version": "1.0.0",
  "description": "نظام كافيه متكامل: كاشير (POS) + لوحة تحكم للإدارة",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "setup": "npm run install:all && npm run seed && npm run build",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "desktop": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kabana.cafe",
    "productName": "Kabana Cafe",
    "directories": { "output": "desktop/out" },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "client/dist/**/*",
      "!server/data/**/*",
      "!**/node_modules/.cache/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "كابانا كافيه"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Icon from '@/components/ui/Icon.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import FAQ from '@/components/FAQ.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { wa, waMessages } from '@/config/site';

export async function getStaticPaths() {
  const fields = await getCollection('fields');
  return fields.map((f) => ({ params: { slug: f.id }, props: { field: f } }));
}
const { field } = Astro.props;
const d = field.data;
const { Content } = await render(field);
const services = (await getCollection('services', (s) => d.services.includes(s.id))).sort((a, b) => d.services.indexOf(a.id) - d.services.indexOf(b.id));
const others = (await getCollection('fields')).filter((f) => f.id !== field.id).sort((a, b) => a.data.order - b.data.order);
const msg = waMessages.field(d.title);
---
<BaseLayout title={d.seoTitle} description={d.seoDescription} ogImage={`/og/fields-${field.id}.png`}>
  <PageHero
    crumbs={[{ href: '/services/#fields', label: 'المجالات' }, { href: `/fields/${field.id}/`, label: d.title }]}
    eyebrow="مجال أكاديمي"
    title={d.title}
    lead={d.short}
  >
    <a slot="actions" class="btn btn--wa btn--lg" href={wa(msg)} target="_blank" rel="noopener" data-fab-hide>
      <BrandIcon name="whatsapp" /> أخبرنا عن بحثك
    </a>
    <a slot="actions" class="btn btn--outline btn--lg" href="/request/">ابدأ طلبك</a>
  </PageHero>

  <section class="section">
    <div class="container fd-intro">
      <div class="prose" data-reveal="fade"><Content /></div>
      <div class="fd-topics card" data-reveal="fade" data-delay="0.1">
        <h2 class="fd-h">الموضوعات التي نعمل عليها</h2>
        <ul role="list" class="fd-tags">
          {d.topics.map((t) => <li class="chip">{t}</li>)}
        </ul>
        <h2 class="fd-h fd-h--gap">أعمال شائعة في هذا المجال</h2>
        <ul role="list" class="fd-typical">
          {d.typical.map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--cream50" aria-labelledby="fs-title">
    <div class="container">
      <SectionTitle id="fs-title" eyebrow="الخدمات" title={`كيف ندعم بحثك في ${d.title}`} />
      <ul role="list" class="fd-svcs" data-reveal="stagger">
        {services.map((s) => (
          <li>
            <a class="fd-svc" href={`/services/${s.id}/`}>
              <span class="fd-svc__icon"><Icon name={s.data.icon} size={22} /></span>
              <span>
                <span class="fd-svc__title">{s.data.title}</span>
                <span class="fd-svc__short">{s.data.short}</span>
              </span>
              <Icon name="arrow-left" size={18} class="fd-svc__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {(d.tests.length > 0 || d.mistakes.length > 0) && (
    <section class="section" aria-labelledby="ft-title">
      <div class="container fd-deep">
        {d.tests.length > 0 && (
          <div>
            <SectionTitle id="ft-title" eyebrow="التحليل الإحصائي" title="اختبارات تتكرر في هذا المجال" />
            <ol role="list" class="fd-tests" data-reveal="stagger">
              {d.tests.map((t) => (
                <li>
                  <h3 class="fd-tests__name">{t.name}</h3>
                  <p>{t.use}</p>
                </li>
              ))}
            </ol>
          </div>
        )}
        {d.mistakes.length > 0 && (
          <aside class="fd-mistakes card" aria-labelledby="fm-title" data-reveal="fade">
            <h2 id="fm-title" class="fd-h"><Icon name="triangle-alert" size={22} /> أخطاء شائعة نراها في رسائل هذا المجال</h2>
            <ul role="list">
              {d.mistakes.map((m) => <li>{m}</li>)}
            </ul>
          </aside>
        )}
      </div>
    </section>
  )}

  {d.exampleTitles.length > 0 && (
    <section class="section section--tight section--cream50" aria-labelledby="fx-title">
      <div class="container">
        <h2 id="fx-title" class="fd-h">أمثلة على عناوين نعمل على أمثالها</h2>
        <p class="fd-note">عناوين افتراضية للتوضيح، وليست من ملفات عملاء.</p>
        <ul role="list" class="fd-examples">
          {d.exampleTitles.map((t) => <li><Icon name="file-text" size={18} /><span>{t}</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {d.faq.length > 0 && (
    <section class="section" aria-labelledby="ffaq-title">
      <div class="container container--narrow">
        <SectionTitle id="ffaq-title" eyebrow="أسئلة شائعة" title="أسئلة من طلاب هذا المجال" />
        <FAQ items={d.faq} />
      </div>
    </section>
  )}

  <section class="section section--tight section--cream50" aria-labelledby="of-title">
    <div class="container">
      <h2 id="of-title" class="fd-h">مجالات أخرى</h2>
      <ul role="list" class="fd-others">
        {others.map((f) => <li><a href={`/fields/${f.id}/`}><Icon name={f.data.icon} size={18} /> {f.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <FinalCTA waMessage={msg} />
</BaseLayout>

<style>
  .fd-intro { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1024px) { .fd-intro { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .fd-topics { padding: 1.75rem; }
  .fd-h { font-size: var(--fs-h3); margin-bottom: 1rem; }
  .fd-h--gap { margin-top: 2rem; }
  .fd-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fd-tags .chip { font-size: var(--fs-small); padding: 0.4rem 0.9rem; }
  .fd-typical { display: grid; gap: 0.75rem; }
  .fd-typical li { display: flex; gap: 0.6rem; line-height: 1.8; }
  .fd-typical :global(svg) { color: var(--brick-600); margin-top: 0.35rem; }
  .fd-svcs { display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .fd-svcs { grid-template-columns: 1fr 1fr; } }
  .fd-svc {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: var(--cream-100);
    border: 1px solid var(--line-light);
    text-decoration: none;
    transition: border-color 0.3s, transform 0.4s var(--ease-expo);
  }
  .fd-svc:hover { border-color: var(--brick-600); transform: translateY(-2px); }
  .fd-svc__icon { display: grid; place-items: center; width: 48px; height: 48px; flex-shrink: 0; border-radius: 12px; background: var(--indigo-900); color: var(--cream-100); }
  .fd-svc__title { display: block; font-weight: 600; color: var(--indigo-900); }
  .fd-svc__short { display: block; font-size: var(--fs-small); color: var(--ink-muted); line-height: 1.7; }
  .fd-svc :global(.fd-svc__arrow) { margin-inline-start: auto; color: var(--brick-600); flex-shrink: 0; }
  .fd-deep { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1024px) { .fd-deep { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .fd-tests { display: grid; gap: 1rem; counter-reset: t; }
  .fd-tests li { position: relative; padding: 1.1rem 1.25rem; padding-inline-start: 3.25rem; border-radius: var(--radius-m); background: var(--cream-50); border: 1px solid var(--line-light); counter-increment: t; }
  .fd-tests li::before { content: counter(t, arabic-indic); position: absolute; inset-inline-start: 1.1rem; top: 1rem; font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--brick-600); }
  .fd-tests__name { font-size: 1.05rem; font-family: var(--font-body); font-weight: 600; color: var(--indigo-900); margin-bottom: 0.35rem; line-height: 1.6; }
  .fd-tests p { color: var(--ink-muted); font-size: var(--fs-small); line-height: 1.85; }
  .fd-mistakes { padding: 1.75rem; background: var(--indigo-900); color: var(--on-dark); border-color: var(--line-dark); }
  @media (min-width: 1024px) { .fd-mistakes { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .fd-mistakes .fd-h { color: var(--on-dark); display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.5; }
  .fd-mistakes .fd-h :global(svg) { color: var(--brick-400); flex-shrink: 0; margin-top: 0.3rem; }
  .fd-mistakes ul { display: grid; gap: 0.9rem; }
  .fd-mistakes li { position: relative; padding-inline-start: 1.1rem; color: var(--on-dark-muted); line-height: 1.85; font-size: var(--fs-small); }
  .fd-mistakes li::before { content: ''; position: absolute; inset-inline-start: 0; top: 0.75em; width: 6px; height: 6px; border-radius: 50%; background: var(--brick-400); }
  .fd-note { font-size: var(--fs-small); color: var(--ink-muted); margin: -0.5rem 0 1rem; }
  .fd-examples { display: grid; gap: 0.6rem; }
  @media (min-width: 900px) { .fd-examples { grid-template-columns: 1fr 1fr; } }
  .fd-examples li { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.9rem 1rem; border-radius: var(--radius-m); background: var(--cream-100); border: 1px solid var(--line-light); line-height: 1.8; }
  .fd-examples :global(svg) { color: var(--indigo-700); flex-shrink: 0; margin-top: 0.3rem; }
  .fd-others { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .fd-others a {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.5rem 1rem;
    border-radius: var(--radius-pill); border: 1px solid var(--line-light); background: var(--cream-100);
    text-decoration: none; color: var(--indigo-900); font-weight: 500;
  }
  .fd-others a:hover { background: var(--indigo-900); color: var(--cream-100); }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import WorkCard from '@/components/WorkCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import Icon from '@/components/ui/Icon.astro';
import { workCategories, type WorkCategory } from '@/data/work';

const works = (await getCollection('portfolio', (w) => w.data.published)).sort((a, b) => a.data.order - b.data.order);
const cats = (Object.keys(workCategories) as WorkCategory[]).filter((c) => works.some((w) => w.data.categories.includes(c)));
---
<BaseLayout
  title="أعمالنا: نماذج من التحليل الإحصائي والاستبانات والتنسيق والترجمة"
  description="عينات من أعمال بابل أكاديمي بلا أسماء: استبانات محكمة، تقارير تحليل إحصائي عربية، تنسيق رسائل، ترجمة أكاديمية، عروض مناقشة، سير ذاتية، وحلول تقنية."
>
  <PageHero
    crumbs={[{ href: '/work/', label: 'أعمالنا' }]}
    eyebrow="المعرض"
    title="عيّنات من شغلنا — بلا أسماء، وبكل التفاصيل."
    lead="لا نذكر اسم عميل ولا جامعة ولا جهة، ولا ننقل أي نص من ملف عميل. نعرض المرحلة والمجال وما نفذناه بالضبط."
  />

  <section class="section work-sec">
    <div class="container">
      <div class="filters" role="group" aria-label="تصفية الأعمال حسب النوع" data-filters>
        <button type="button" class="filter" aria-pressed="true" data-filter="all">الكل <span class="filter__n">{works.length}</span></button>
        {cats.map((c) => (
          <button type="button" class="filter" aria-pressed="false" data-filter={c}>
            {workCategories[c]} <span class="filter__n">{works.filter((w) => w.data.categories.includes(c)).length}</span>
          </button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
      <ul role="list" class="masonry" data-grid>
        {works.map((w) => (
          <li class="masonry__item" data-cats={w.data.categories.join(' ')} data-flip-id={w.id}>
            <WorkCard item={w} headingLevel="h2" />
          </li>
        ))}
      </ul>
      <p class="work-note" data-reveal="fade">
        <Icon name="shield-check" size={20} />
        كل عمل معروض هنا بعد حذف ما يدل على صاحبه. المجسمات توضيحية بنص عام، وستحل محلها لقطات مموهة من الأعمال نفسها.
      </p>
    </div>
  </section>

  <FinalCTA title="عندك عمل مشابه؟" text="أرسل لنا تفاصيله، ونخبرك كيف نعمل عليه، وماذا ستستلم، ومتى، وبكم." />
</BaseLayout>

<style>
  .work-sec { padding-top: calc(var(--space-section) * 0.6); }
  .filters { display: none; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  :global(.js) .filters { display: flex; }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-light);
    background: var(--cream-50);
    color: var(--indigo-900);
    font-weight: 500;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .filter:hover { border-color: var(--indigo-900); }
  .filter[aria-pressed='true'] { background: var(--indigo-900); color: var(--cream-100); border-color: var(--indigo-900); }
  .filter__n { font-size: var(--fs-xs); opacity: 0.65; }
  .masonry { columns: 1; column-gap: 1.25rem; }
  .masonry__item { break-inside: avoid; margin-bottom: 1.25rem; }
  .masonry__item[hidden] { display: none; }
  @media (min-width: 720px) { .masonry { columns: 2; } }
  @media (min-width: 1100px) { .masonry { columns: 3; column-gap: 1.5rem; } .masonry__item { margin-bottom: 1.5rem; } }
  /* تنويع ارتفاعات المجسمات لإحساس masonry */
  .masonry__item:nth-child(3n + 2) :global(.work-card__visual) { aspect-ratio: 1 / 1; }
  .masonry__item:nth-child(4n) :global(.work-card__visual) { aspect-ratio: 5 / 4; }
  .work-note { display: flex; gap: 0.6rem; align-items: flex-start; margin-top: 2rem; font-size: var(--fs-small); color: var(--ink-muted); max-width: 70ch; }
  .work-note :global(svg) { color: var(--brick-600); margin-top: 0.25rem; }
</style>

<script>
  import { gsap } from '@/scripts/motion-core';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-cats]')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const reduce = document.documentElement.classList.contains('rm');
  if (bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const apply = (cat: string, animate = true) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      const state = Flip.getState(items);
      let shown = 0;
      items.forEach((it) => {
        const show = cat === 'all' || it.dataset.cats!.split(' ').includes(cat);
        it.hidden = !show;
        if (show) shown++;
      });
      if (status) status.textContent = `يُعرض ${shown} من الأعمال`;
      if (animate && !reduce) {
        Flip.from(state, {
          duration: 0.7,
          ease: 'power2.inOut',
          scale: true,
          absolute: true,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.94 }, { opacity: 1, scale: 1, duration: 0.5, delay: 0.2 }),
          onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.94, duration: 0.35 }),
        });
      }
      const url = new URL(location.href);
      if (cat === 'all') url.searchParams.delete('cat'); else url.searchParams.set('cat', cat);
      history.replaceState(null, '', url);
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
    const initial = new URL(location.href).searchParams.get('cat');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  }
</script>

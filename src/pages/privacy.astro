---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { site } from '@/config/site';
const entity = site.legalEntity ? `${site.nameAr} (${site.legalEntity})` : site.nameAr;
---
<LegalLayout title="سياسة الخصوصية" path="/privacy/" description="كيف يجمع بابل أكاديمي بياناتك ويستخدمها ويحميها، وحقوقك وفق نظام حماية البيانات الشخصية في المملكة العربية السعودية.">
  <p>توضح هذه السياسة كيف يتعامل {entity} مع البيانات الشخصية والملفات التي تشاركها معنا عند زيارة الموقع أو التواصل معنا أو طلب خدماتنا. نلتزم في ذلك بنظام حماية البيانات الشخصية في المملكة العربية السعودية ولوائحه التنفيذية.</p>

  <h2>البيانات التي نجمعها</h2>
  <p>لا يجمع الموقع نفسه بيانات شخصية عبر نماذج مرسلة إلى خوادمنا. نموذج الطلب ونموذج الرسالة السريعة يجهزان رسالة تُفتح في تطبيق واتساب على جهازك، ولا تصلنا إلا إذا أرسلتها أنت. وتحفظ مسودة نموذج الطلب في متصفحك فقط (التخزين المحلي) حتى لا تضيع إن خرجت من الصفحة، وتُحذف بعد الإرسال.</p>
  <p>حين تتواصل معنا، قد نتلقى:</p>
  <ul>
    <li>بيانات التواصل: الاسم ورقم الجوال، والبريد الإلكتروني إن شاركته.</li>
    <li>بيانات الطلب: مرحلتك الدراسية وتخصصك والخدمة المطلوبة والموعد.</li>
    <li>الملفات التي ترسلها: المسودات، وملفات البيانات، وأدلة الجامعة، وملاحظات المشرف.</li>
  </ul>

  <h2>لماذا نستخدمها</h2>
  <ul>
    <li>لفهم طلبك وإعداد عرض مكتوب له.</li>
    <li>لتنفيذ الخدمة المتفق عليها والتواصل معك بشأنها.</li>
    <li>للوفاء بالتزاماتنا النظامية والمحاسبية.</li>
  </ul>
  <p>لا نستخدم بياناتك في التسويق دون موافقتك، ولا نبيعها ولا نؤجرها لأي جهة.</p>

  <h2>سرية الملفات</h2>
  <p>ملفاتك لا يطلع عليها إلا المختص الذي يعمل على طلبك. لا نشارك أي ملف أو جزء منه مع أي جهة، ولا نستخدمه في أي عمل آخر. وإذا عرضنا نموذجًا من عمل ما في معرض أعمالنا، فبعد حذف كل ما يدل على صاحبه: لا اسم، ولا جامعة، ولا جهة، ولا نص منقول من الملف.</p>

  <h2>المشاركة مع أطراف أخرى</h2>
  <p>قد تمر بعض البيانات عبر مزودي خدمات نعتمد عليهم في التواصل والتخزين (مثل واتساب)، وفق سياساتهم. ولا نفصح عن بياناتك لغير ذلك إلا إذا ألزمنا نظام نافذ أو طلب من جهة مختصة.</p>

  <h2>مدة الاحتفاظ</h2>
  <p>نحتفظ بالبيانات والملفات طوال مدة تنفيذ الخدمة وما يلزم بعدها للمتابعة والتعديلات المتفق عليها والالتزامات النظامية، ثم نحذفها أو نجعلها غير قابلة للتعرف. ويمكنك طلب حذف ملفاتك في أي وقت بعد انتهاء الخدمة.</p>

  <h2>حقوقك</h2>
  <p>وفق نظام حماية البيانات الشخصية، لك الحق في:</p>
  <ul>
    <li>العلم بكيفية جمع بياناتك والغرض منه.</li>
    <li>الوصول إلى بياناتك التي لدينا والحصول على نسخة منها.</li>
    <li>طلب تصحيح بياناتك أو تحديثها.</li>
    <li>طلب إتلاف بياناتك متى انتهت الحاجة إليها.</li>
    <li>الرجوع عن موافقتك على المعالجة متى كانت الموافقة أساسها.</li>
  </ul>
  <p>لممارسة أي من هذه الحقوق، راسلنا عبر قنوات التواصل أدناه، ونرد على طلبك في المدة التي يحددها النظام.</p>

  <h2>ملفات تعريف الارتباط والتحليلات</h2>
  <p>لا يستخدم الموقع حاليًا ملفات تعريف ارتباط لأغراض الإعلان أو التتبع. وإذا أضفنا أدوات تحليل أو قياس إعلاني لاحقًا، سنحدّث هذه السياسة ونوضح ما تجمعه تلك الأدوات.</p>

  <h2>التواصل</h2>
  <p>لأي سؤال عن خصوصية بياناتك: واتساب <span dir="ltr">+{site.whatsapp}</span>{site.email && <>، أو البريد الإلكتروني <a href={`mailto:${site.email}`}>{site.email}</a></>}.</p>

  <h2>تحديث السياسة</h2>
  <p>قد نحدّث هذه السياسة عند تغير خدماتنا أو الأنظمة، ونضع تاريخ آخر تحديث أعلى الصفحة.</p>
</LegalLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { site, wa, waMessages } from '@/config/site';

const phoneDisplay = `+${site.whatsapp.slice(0, 3)} ${site.whatsapp.slice(3, 5)} ${site.whatsapp.slice(5, 8)} ${site.whatsapp.slice(8)}`;
const topics = ['استفسار عام', 'سؤال عن خدمة', 'متابعة طلب قائم', 'تعاون أو شراكة'];
---
<BaseLayout
  title="تواصل معنا"
  description="تواصل مع بابل أكاديمي عبر واتساب لإرسال تفاصيل رسالتك وملفاتك، ونرسل لك عرضًا مكتوبًا بالخطوة التالية وتكلفتها قبل أي التزام."
  motion={false}
>
  <PageHero
    compact
    crumbs={[{ href: '/contact/', label: 'تواصل معنا' }]}
    eyebrow="تواصل معنا"
    title="طبقتك التالية تبدأ برسالة."
    lead="أسرع طريق إلينا واتساب: ترسل التفاصيل والملفات في مكان واحد، ونرد عليك حسب ترتيب الوصول."
  >
    <a slot="actions" class="btn btn--wa btn--lg" href={wa(waMessages.general)} target="_blank" rel="noopener" data-fab-hide><BrandIcon name="whatsapp" /> افتح محادثة واتساب</a>
    <a slot="actions" class="btn btn--outline btn--lg" href="/request/">ابدأ طلبًا منظمًا</a>
  </PageHero>

  <section class="section">
    <div class="container ct-grid">
      <div class="ct-channels">
        <a class="ct-ch card" href={wa(waMessages.general)} target="_blank" rel="noopener">
          <span class="ct-ch__icon ct-ch__icon--wa"><BrandIcon name="whatsapp" size={26} /></span>
          <span class="ct-ch__label">واتساب</span>
          <span class="ct-ch__val" dir="ltr">{phoneDisplay}</span>
        </a>
        {site.email && (
          <a class="ct-ch card" href={`mailto:${site.email}`}>
            <span class="ct-ch__icon"><Icon name="mail" size={24} /></span>
            <span class="ct-ch__label">البريد الإلكتروني</span>
            <span class="ct-ch__val" dir="ltr">{site.email}</span>
          </a>
        )}
        <div class="ct-ch card">
          <span class="ct-ch__icon"><Icon name="map-pin" size={24} /></span>
          <span class="ct-ch__label">المدينة</span>
          <span class="ct-ch__val">{site.city}، المملكة العربية السعودية</span>
        </div>
        <div class="ct-tips">
          <h2>لرد أسرع وأدق</h2>
          <ul role="list">
            <li><Icon name="check" size={18} /> اذكر مرحلتك وتخصصك والخدمة التي تحتاجها.</li>
            <li><Icon name="check" size={18} /> أرفق دليل الجامعة وملاحظات المشرف إن وجدت.</li>
            <li><Icon name="check" size={18} /> حدد الموعد الذي تحتاج فيه العمل.</li>
          </ul>
        </div>
      </div>

      <form class="ct-form card" data-ct-form action={`https://wa.me/${site.whatsapp}`} method="get" target="_blank">
        <h2>رسالة سريعة</h2>
        <p class="muted">اكتب رسالتك هنا، ونفتحها لك جاهزة في واتساب.</p>
        <fieldset class="ct-topics">
          <legend>موضوع الرسالة</legend>
          <div class="ct-topics__opts">
            {topics.map((t, i) => (
              <label><input type="radio" name="topic" value={t} checked={i === 0} /><span>{t}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="ct-field">
          <label for="ct-name">الاسم</label>
          <input id="ct-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="ct-field">
          <label for="ct-msg">رسالتك</label>
          <textarea id="ct-msg" name="text" rows="5" required placeholder="اكتب سؤالك أو تفاصيل طلبك"></textarea>
          <p class="ct-err" data-ct-err hidden>اكتب رسالتك أولًا.</p>
        </div>
        <button class="btn btn--wa btn--lg" type="submit"><BrandIcon name="whatsapp" /> افتحها في واتساب</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .ct-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 1024px) { .ct-grid { grid-template-columns: 1fr 1.1fr; gap: 3rem; } }
  .ct-channels { display: grid; gap: 1rem; }
  .ct-ch { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1rem; align-items: center; padding: 1.25rem 1.4rem; text-decoration: none; transition: transform 0.3s var(--ease-expo), border-color 0.3s; }
  a.ct-ch:hover { transform: translateY(-2px); border-color: var(--brick-600); }
  .ct-ch__icon { grid-row: span 2; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--indigo-900); color: var(--cream-100); }
  .ct-ch__icon--wa { background: var(--whatsapp); color: #fff; }
  .ct-ch__label { font-size: var(--fs-small); color: var(--ink-muted); }
  .ct-ch__val { font-weight: 600; color: var(--indigo-900); text-align: start; }
  .ct-tips { padding: 1.5rem; border-radius: var(--radius-card); border: 1px dashed rgba(44, 26, 69, 0.25); }
  .ct-tips h2 { font-size: var(--fs-h3); margin-bottom: 0.75rem; }
  .ct-tips ul { display: grid; gap: 0.6rem; }
  .ct-tips li { display: flex; gap: 0.6rem; line-height: 1.8; }
  .ct-tips :global(svg) { color: var(--brick-600); margin-top: 0.35rem; }

  .ct-form { padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: grid; gap: 1.1rem; }
  .ct-form h2 { font-size: var(--fs-h3); }
  .ct-topics { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ct-topics legend { font-weight: 600; color: var(--indigo-900); margin-bottom: 0.6rem; padding: 0; }
  .ct-topics__opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ct-topics label { position: relative; cursor: pointer; }
  .ct-topics input { position: absolute; opacity: 0; inset: 0; pointer-events: none; }
  .ct-topics span { display: inline-flex; align-items: center; min-height: 44px; padding: 0.45rem 1rem; border-radius: var(--radius-pill); border: 1.5px solid var(--line-light); background: var(--cream-100); font-weight: 500; color: var(--indigo-900); }
  .ct-topics input:checked + span { background: var(--indigo-900); color: var(--cream-100); border-color: var(--indigo-900); }
  .ct-topics input:focus-visible + span { outline: 2px solid var(--brick-600); outline-offset: 3px; }
  .ct-field { display: grid; gap: 0.4rem; }
  .ct-field label { font-weight: 600; color: var(--indigo-900); }
  .ct-field input, .ct-field textarea { width: 100%; min-height: 52px; padding: 0.8rem 1rem; border-radius: var(--radius-s); border: 1.5px solid rgba(44, 26, 69, 0.2); background: var(--cream-100); line-height: 1.8; }
  .ct-field input:focus, .ct-field textarea:focus { outline: none; border-color: var(--brick-600); box-shadow: 0 0 0 3px rgba(166, 61, 64, 0.15); }
  .ct-err { color: var(--brick-600); font-size: var(--fs-small); }
  .ct-form .btn { justify-self: start; }
  @media (max-width: 480px) { .ct-form .btn { width: 100%; } }
</style>

<script>
  import { site } from '@/config/site';
  const form = document.querySelector<HTMLFormElement>('[data-ct-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const msg = String(fd.get('text') || '').trim();
    const err = form.querySelector<HTMLElement>('[data-ct-err]')!;
    if (!msg) { err.hidden = false; form.querySelector<HTMLTextAreaElement>('#ct-msg')!.focus(); return; }
    err.hidden = true;
    const name = String(fd.get('name') || '').trim();
    const lines = ['مرحبًا بابل أكاديمي 👋', `الموضوع: ${fd.get('topic')}`, ...(name ? [`الاسم: ${name}`] : []), msg];
    window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>

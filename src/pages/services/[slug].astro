---
import { isPublic } from '@/lib/work';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Icon from '@/components/ui/Icon.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import WorkCard from '@/components/WorkCard.astro';
import FAQ from '@/components/FAQ.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { wa, waMessages, site, siteUrl } from '@/config/site';
import { serviceLayer } from '@/data/services';
import { bidi } from '@/lib/bidi';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}
const { service } = Astro.props;
const d = service.data;
const { Content } = await render(service);
const works = (await getCollection('portfolio', (w) => isPublic(w) && d.related.includes(w.id))).sort((a, b) => a.data.order - b.data.order);
const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const relatedServices = d.relatedServices.map((id) => allServices.find((s) => s.id === id)).filter((s) => s !== undefined);
const others = allServices.filter((s) => s.id !== service.id && !d.relatedServices.includes(s.id));
const msg = waMessages.service(d.title, d.keyword);
const publicWorks = new Set((await getCollection('portfolio', isPublic)).map((w) => w.id));
const digits = ['١', '٢', '٣', '٤', '٥', '٦', '٧', '٨'];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  description: d.seoDescription,
  serviceType: d.title,
  areaServed: { '@type': 'Country', name: 'المملكة العربية السعودية' },
  provider: { '@type': 'ProfessionalService', name: site.nameAr, ...(siteUrl ? { url: siteUrl } : {}) },
  ...(siteUrl ? { url: new URL(`/services/${service.id}/`, siteUrl).href } : {}),
};
---
<BaseLayout title={d.seoTitle} description={d.seoDescription} jsonLd={ld} ogImage={`/og/services-${service.id}.png`}>
  <PageHero
    crumbs={[{ href: '/services/', label: 'الخدمات' }, { href: `/services/${service.id}/`, label: d.title }]}
    eyebrow={serviceLayer[service.id] !== undefined ? `الطبقة ${digits[serviceLayer[service.id]]} من البرج` : 'خدمة'}
    title={d.title}
    lead={d.promise}
    activeTier={serviceLayer[service.id]}
  >
    <a slot="actions" class="btn btn--wa btn--lg" href={wa(msg)} target="_blank" rel="noopener" data-magnetic data-fab-hide>
      <BrandIcon name="whatsapp" /> اسألنا عن هذه الخدمة
    </a>
    <a slot="actions" class="btn btn--outline btn--lg" href={`/request/?service=${service.id}`}>ابدأ طلبك</a>
  </PageHero>

  <section class="section">
    <div class="container sv-intro">
      <div class="prose sv-intro__text" data-reveal="fade"><Content /></div>
      <aside class="sv-for card" aria-labelledby="for-title" data-reveal="fade" data-delay="0.1">
        <h2 id="for-title" class="sv-for__title">لمن هذه الخدمة</h2>
        <ul role="list" class="sv-for__list">
          {d.audience.map((a) => (
            <li><Icon name="check" size={20} /><span>{a}</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {d.variants.length > 0 && (
    <section class="section section--cream50" aria-labelledby="types-title" id="types">
      <div class="container">
        <SectionTitle id="types-title" eyebrow="الأنواع" title="اختر النوع الذي تحتاجه" lead="السعر حسب حجم العمل. اختر النوع، ونرد عليك بالتفاصيل والمدة والتكلفة قبل أي التزام." />
        <ul role="list" class="sv-types" data-reveal="stagger">
          {d.variants.map((v) => (
            <li class="sv-type">
              <span class="sv-type__icon"><Icon name={v.icon} size={24} /></span>
              <h3 class="sv-type__title">{v.title}</h3>
              <p class="sv-type__text" set:html={bidi(v.text)} />
              <div class="sv-type__actions">
                <a class="btn btn--wa btn--sm" href={wa(waMessages.service(v.title, v.keyword))} target="_blank" rel="noopener" data-wa-loc="service_type">
                  <BrandIcon name="whatsapp" size={18} /> «{v.keyword}» على واتساب
                </a>
                {v.work && publicWorks.has(v.work) && (
                  <a class="link-arrow sv-type__work" href={`/work/${v.work}/`}>شاهد نموذجًا <Icon name="arrow-left" size={16} /></a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--dark" aria-labelledby="get-title">
    <div class="container">
      <SectionTitle id="get-title" eyebrow="التسليمات" title="ماذا تستلم بالضبط" lead="قائمة مكتوبة في العرض قبل أن تدفع، تعرف منها ما سيصلك وبأي صيغة." />
      <ol role="list" class="sv-get" data-reveal="stagger">
        {d.deliverables.map((x, i) => (
          <li class="sv-get__item">
            <span class="sv-get__num">{digits[i]}</span>
            <p>{x}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionTitle id="how-title" eyebrow="طريقة العمل" title="كيف نعمل عليها" />
      <ol role="list" class="sv-steps" data-reveal="stagger">
        {d.steps.map((s, i) => (
          <li class="sv-step" style={`--i:${i}`}>
            <span class="sv-step__num">{digits[i]}</span>
            <div>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {works.length > 0 && (
    <section class="section section--cream50" aria-labelledby="rel-title">
      <div class="container">
        <SectionTitle id="rel-title" eyebrow="من أعمالنا" title="عمل ذو صلة" />
        <ul role="list" class="sv-works" data-reveal="stagger">
          {works.map((w) => <li><WorkCard item={w} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="sfaq-title">
    <div class="container container--narrow">
      <SectionTitle id="sfaq-title" eyebrow="أسئلة شائعة" title={`أسئلة عن ${d.title}`} />
      <FAQ items={d.faq} />
    </div>
  </section>

  {relatedServices.length > 0 && (
    <section class="section section--tight" aria-labelledby="relsv-title">
      <div class="container">
        <h2 id="relsv-title" class="sv-more__title">خدمات مرتبطة</h2>
        <ul role="list" class="sv-rel">
          {relatedServices.map((s) => (
            <li>
              <a class="sv-rel__card" href={`/services/${s.id}/`}>
                <span class="sv-rel__icon"><Icon name={s.data.icon} size={22} /></span>
                <span>
                  <span class="sv-rel__title">{s.data.title}</span>
                  <span class="sv-rel__short">{s.data.short}</span>
                </span>
                <Icon name="arrow-left" size={18} class="sv-rel__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--tight section--cream50" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" class="sv-more__title">خدمات أخرى</h2>
      <ul role="list" class="sv-more">
        {others.map((s) => (
          <li><a href={`/services/${s.id}/`}><Icon name={s.data.icon} size={20} /> {s.data.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCTA title="جاهز للخطوة التالية؟" text={`أرسل لنا تفاصيل عملك في ${d.title}، ونرسل لك نطاق العمل والموعد والتكلفة مكتوبة قبل أي التزام.`} waMessage={msg} />
</BaseLayout>

<style>
  .sv-intro { display: grid; gap: 2.5rem; align-items: start; }
  .sv-for { padding: 1.75rem; }
  .sv-for__title { font-size: var(--fs-h3); margin-bottom: 1rem; }
  .sv-for__list { display: grid; gap: 0.9rem; }
  .sv-for__list li { display: flex; gap: 0.75rem; align-items: flex-start; line-height: 1.8; }
  .sv-for__list :global(svg) { color: var(--brick-600); margin-top: 0.3rem; }
  @media (min-width: 1024px) { .sv-intro { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .sv-get { display: grid; gap: 1rem; }
  .sv-get__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-dark);
    background: rgba(244, 239, 228, 0.04);
    line-height: 1.8;
  }
  .sv-get__num { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: var(--brick-400); line-height: 1.3; min-width: 1.2em; }
  @media (min-width: 900px) { .sv-get { grid-template-columns: 1fr 1fr; } }

  .sv-steps { display: grid; gap: 1rem; }
  .sv-step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--cream-50);
    border: 1px solid var(--line-light);
  }
  .sv-step h3 { font-size: 1.25rem; margin-bottom: 0.25rem; }
  .sv-step__num {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--indigo-900);
    color: var(--cream-100);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
  }
  /* درجات متصاعدة كالبرج على الشاشات الواسعة */
  @media (min-width: 1024px) {
    .sv-steps { grid-auto-flow: column; grid-auto-columns: 1fr; align-items: end; }
    .sv-step { flex-direction: column; margin-bottom: calc(var(--i) * 1.75rem); }
  }

  .sv-types { display: grid; gap: 1rem; }
  @media (min-width: 720px) { .sv-types { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .sv-types { grid-template-columns: repeat(3, 1fr); } }
  .sv-type {
    display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem;
    border-radius: var(--radius-card); background: var(--cream-100); border: 1px solid var(--line-light);
  }
  .sv-type__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--indigo-900); color: var(--cream-100); margin-bottom: 0.25rem; }
  .sv-type__title { font-size: 1.2rem; line-height: 1.5; }
  .sv-type__text { color: var(--ink-muted); font-size: var(--fs-small); line-height: 1.85; }
  .sv-type__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: auto; padding-top: 0.5rem; }
  .sv-type__work { font-size: var(--fs-small); }

  .sv-rel { display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .sv-rel { grid-template-columns: repeat(3, 1fr); } }
  .sv-rel__card {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1.1rem 1.25rem;
    border-radius: var(--radius-card); background: var(--cream-50); border: 1px solid var(--line-light);
    text-decoration: none; transition: border-color 0.3s, transform 0.4s var(--ease-expo);
  }
  .sv-rel__card:hover { border-color: var(--brick-600); transform: translateY(-2px); }
  .sv-rel__icon { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; border-radius: 12px; background: var(--indigo-900); color: var(--cream-100); }
  .sv-rel__title { display: block; font-weight: 600; color: var(--indigo-900); line-height: 1.5; }
  .sv-rel__short { display: block; font-size: var(--fs-xs); color: var(--ink-muted); line-height: 1.7; margin-top: 0.15rem; }
  .sv-rel__card :global(.sv-rel__arrow) { margin-inline-start: auto; color: var(--brick-600); flex-shrink: 0; }

  .sv-works { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .sv-works { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .sv-works { grid-template-columns: repeat(3, 1fr); } }

  .sv-more__title { font-size: var(--fs-h3); margin-bottom: 1.25rem; }
  .sv-more { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sv-more a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-light);
    background: var(--cream-100);
    text-decoration: none;
    font-weight: 500;
    color: var(--indigo-900);
    transition: background-color 0.3s, color 0.3s;
  }
  .sv-more a:hover { background: var(--indigo-900); color: var(--cream-100); }
</style>

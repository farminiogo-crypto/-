---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { site } from '@/config/site';
const p = site.policy;
const entity = site.legalEntity ? `${site.nameAr} (${site.legalEntity})` : site.nameAr;
---
<LegalLayout title="الشروط والأحكام" path="/terms/" description="شروط التعامل مع بابل أكاديمي: طبيعة الخدمات، العرض المكتوب، الدفع على مراحل، التعديلات، الإلغاء والاسترداد، والنزاهة العلمية.">
  <p>تنظم هذه الشروط التعامل بينك وبين {entity} عند طلب أي من خدماتنا. إرسال الموافقة على العرض المكتوب أو سداد الدفعة الأولى يعني قبولك لهذه الشروط.</p>

  <h2>طبيعة الخدمات</h2>
  <p>نقدم خدمات استشارة منهجية، وتصميم أدوات القياس، والتحليل الإحصائي وشرحه، والتحرير والتدقيق، والتنسيق والتوثيق والتحقق من المراجع، والترجمة، وتصميم العروض والتحضير للمناقشة، والسير الذاتية، والحلول التقنية، والتدريب. هدف خدماتنا في الرسائل والأبحاث أن تفهم عملك وتطوره وتعرضه بجودة أعلى، ويبقى العمل عملك وقراراته قراراتك.</p>

  <h2>العرض المكتوب</h2>
  <p>قبل أي دفع نرسل لك عرضًا مكتوبًا يحدد: نطاق العمل والتسليمات، والمراحل وموعد كل منها، وعدد جولات التعديل المشمولة، والتكلفة. هذا العرض هو المرجع في أي خلاف، وما لم يرد فيه لا يدخل في نطاق الخدمة إلا باتفاق مكتوب جديد.</p>

  <h2>الدفع على مراحل</h2>
  <p>{p.firstPaymentPercent ? `يبدأ العمل بعد سداد دفعة أولى قدرها ${p.firstPaymentPercent}٪ من قيمة العرض` : 'يبدأ العمل بعد سداد الدفعة الأولى المحددة في العرض'}، ويُسدد الباقي على مراحل مرتبطة بتسليمات واضحة. تستلم كل مرحلة وتراجعها قبل أن ننتقل إلى التي بعدها.</p>

  <h2>التعديلات</h2>
  <p>{p.revisionRounds ? `تشمل الخدمة ${p.revisionRounds} جولات تعديل` : 'تشمل الخدمة عدد جولات التعديل المحدد في العرض'} على التسليمات ضمن نطاق العمل المتفق عليه، سواء كانت الملاحظات منك أو من مشرفك{p.revisionWindowDays ? `، على أن تُطلب خلال ${p.revisionWindowDays} يومًا من التسليم` : ''}. أما التعديلات التي تغير النطاق (منهج مختلف، أو متغيرات أو فصول جديدة، أو تغيير في دليل الجامعة بعد البدء) فنتفق عليها كتابيًا قبل تنفيذها.</p>

  <h2>المواعيد</h2>
  <p>نلتزم بالمواعيد المكتوبة في العرض. وقد يتأثر الموعد إن تأخر وصول ملفات أو بيانات أو ردود مطلوبة منك، ونبلغك بذلك فور حدوثه مع موعد بديل.</p>

  <h2>الإلغاء والاسترداد</h2>
  <ul>
    <li>{p.refundBeforeStartPercent ? `إذا ألغيت الطلب قبل بدء العمل، نرد لك ${p.refundBeforeStartPercent}٪ من المبلغ المدفوع.` : 'إذا ألغيت الطلب قبل بدء العمل، نرد لك المبلغ المدفوع وفق ما يحدده العرض المكتوب.'}</li>
    <li>بعد بدء العمل، لا تُسترد قيمة المراحل التي سُلمت، ويُحتسب ما أُنجز من المرحلة الجارية.</li>
    <li>إذا تعذر علينا تنفيذ ما التزمنا به في العرض، نرد لك قيمة الجزء الذي لم يُنفذ.</li>
  </ul>

  <h2>النزاهة العلمية</h2>
  <p>نلتزم بتعليمات جامعتك ومشرفك، ونعمل بطريقة تجعلك تفهم كل ما نسلمه. ولا نقبل طلبًا يُراد تقديمه باسم غير صاحبه. لا نعد بدرجة أو قبول أو نتيجة تقييم، فذلك قرار لجنتك وحدها، ومسؤولية استخدام ما نقدمه وفق أنظمة جامعتك تقع عليك.</p>

  <h2>السرية</h2>
  <p>نتعامل مع ملفاتك وبياناتك بسرية تامة وفق <a href="/privacy/">سياسة الخصوصية</a>.</p>

  <h2>الملكية</h2>
  <p>تنتقل إليك ملكية التسليمات النهائية بعد سداد كامل قيمتها. ونحتفظ بحقنا في أدواتنا وقوالبنا وطرق عملنا العامة.</p>

  <h2>قنوات التواصل الرسمية</h2>
  <p>كل الاتفاقات والتسليمات تتم عبر قنواتنا الرسمية: واتساب <span dir="ltr">+{site.whatsapp}</span>{site.email && <> والبريد الإلكتروني <a href={`mailto:${site.email}`}>{site.email}</a></>}.</p>

  <h2>تحديث الشروط</h2>
  <p>قد نحدّث هذه الشروط، ويسري على كل طلب ما كان نافذًا وقت قبول عرضه.</p>
</LegalLayout>

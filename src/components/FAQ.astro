---
interface Props {
  items: { q: string; a: string }[];
  schema?: boolean; // إضافة FAQPage JSON-LD
  dark?: boolean;
}
const { items, schema = true, dark = false } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class={`faq ${dark ? 'faq--dark' : ''}`} data-reveal="stagger">
  {items.map((it) => (
    <details class="faq__item" data-faq>
      <summary class="faq__q">
        <span>{it.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a"><p>{it.a}</p></div>
    </details>
  ))}
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<style>
  .faq { display: grid; gap: 0.75rem; }
  .faq__item {
    border-radius: var(--radius-m);
    background: var(--cream-50);
    border: 1px solid var(--line-light);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq__item[open] { border-color: rgba(166, 61, 64, 0.35); box-shadow: var(--shadow-1); }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--indigo-900);
    line-height: 1.6;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 28px; height: 28px; flex-shrink: 0; border-radius: 50%; background: var(--brick-tint); }
  .faq__icon::before, .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    background: var(--brick-600);
    border-radius: 2px;
    transition: transform 0.4s var(--ease-expo);
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__a { overflow: hidden; }
  .faq__a p { padding: 0 1.25rem 1.25rem; color: var(--ink-muted); line-height: 1.9; max-width: 70ch; }
  .faq--dark .faq__item { background: rgba(244, 239, 228, 0.04); border-color: var(--line-dark); }
  .faq--dark .faq__q { color: var(--on-dark); }
  .faq--dark .faq__a p { color: var(--on-dark-muted); }
</style>

<script>
  // حركة ارتفاع ناعمة للأكورديون مع الإبقاء على details الأصلية (تعمل بدون JS)
  const reduce = document.documentElement.classList.contains('rm');
  document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((d) => {
    const summary = d.querySelector('summary')!;
    const body = d.querySelector<HTMLElement>('.faq__a')!;
    let anim: Animation | null = null;
    summary.addEventListener('click', (e) => {
      if (reduce) return;
      e.preventDefault();
      anim?.cancel();
      if (!d.open) {
        d.open = true;
        const h = body.scrollHeight;
        anim = body.animate({ height: ['0px', `${h}px`], opacity: [0, 1] }, { duration: 420, easing: 'cubic-bezier(0.215, 0.61, 0.355, 1)' });
      } else {
        const h = body.scrollHeight;
        anim = body.animate({ height: [`${h}px`, '0px'], opacity: [1, 0] }, { duration: 320, easing: 'cubic-bezier(0.455, 0.03, 0.515, 0.955)' });
        anim.onfinish = () => { d.open = false; };
      }
    });
  });
</script>

---
import Ziggurat from '@/components/Ziggurat.astro';
import Icon from '@/components/ui/Icon.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { wa, waMessages } from '@/config/site';

// العنوان يُقسَّم إلى كلمات وقت البناء (لا حروف أبدًا) ليتحرك بـ CSS دون انتظار JS
const lines = ['من الفكرة إلى المناقشة…', 'نصعد معك درجةً درجة.'];
let d = 0;
const split = lines.map((l) => l.split(' ').map((w) => ({ w, d: d++ })));
---
<section class="hero" data-hero>
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__badge">دعم أكاديمي لطلاب الماجستير والدكتوراه في المملكة</p>
      <h1 class="hero__title">
        {split.map((line) => (
          <span class="hero__line">
            {line.map(({ w, d }) => (
              <span class="w"><span class="w__in" style={`--d:${d}`}>{w}</span></span>
            ))}
          </span>
        ))}
      </h1>
      <p class="hero__lead">
        فريق من الباحثين والمحللين والمترجمين يرافقك في رسالتك: تحليل إحصائي تفهمه وتدافع عنه، وتنسيق عربي بلا خطأ واحد، ومراجع نتحقق منها واحدًا واحدًا.
      </p>
      <div class="hero__actions" data-fab-hide>
        <a class="btn btn--primary btn--lg" href="/request/" data-magnetic>ابدأ طلبك في دقيقة</a>
        <a class="btn btn--outline btn--lg" href={wa(waMessages.file)} target="_blank" rel="noopener">
          <BrandIcon name="whatsapp" size={20} /> أرسل ملفك على واتساب
        </a>
      </div>
      <p class="hero__trust">
        <Icon name="lock" size={16} />
        <span>سرية تامة · سعر واضح قبل البدء · دفع على مراحل</span>
      </p>
    </div>
    <div class="hero__art" data-hero-art>
      <canvas class="hero__canvas" data-tongues aria-hidden="true"></canvas>
      <div class="hero__tilt" data-tilt>
        <Ziggurat variant="hero" deferred tiers={7} label="زقورة بابل من سبع طبقات، كل طبقة مرحلة من رحلة البحث العلمي" />
      </div>
    </div>
  </div>
  <a class="hero__scroll" href="#tower" aria-label="مرّر للأسفل إلى رحلة البحث">
    <span>مرّر للأسفل</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 5.5rem;
    color: var(--on-dark);
    background:
      radial-gradient(ellipse 80% 70% at 22% 45%, rgba(61, 40, 96, 0.95), transparent 70%),
      radial-gradient(ellipse 60% 50% at 85% 10%, rgba(61, 40, 96, 0.55), transparent 70%),
      linear-gradient(180deg, var(--indigo-950), #22143a 60%, var(--indigo-900));
    overflow: clip;
    isolation: isolate;
  }
  /* نجوم وغبار دقيق */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(1px 1px at 12% 18%, rgba(244, 239, 228, 0.7), transparent 60%),
      radial-gradient(1px 1px at 72% 12%, rgba(244, 239, 228, 0.55), transparent 60%),
      radial-gradient(1.5px 1.5px at 38% 68%, rgba(244, 239, 228, 0.4), transparent 60%),
      radial-gradient(1px 1px at 88% 58%, rgba(244, 239, 228, 0.5), transparent 60%),
      radial-gradient(1px 1px at 22% 88%, rgba(244, 239, 228, 0.35), transparent 60%),
      radial-gradient(1.2px 1.2px at 58% 30%, rgba(196, 89, 91, 0.6), transparent 60%),
      radial-gradient(1px 1px at 5% 50%, rgba(244, 239, 228, 0.45), transparent 60%),
      radial-gradient(1px 1px at 95% 85%, rgba(244, 239, 228, 0.4), transparent 60%);
    background-size: 520px 520px;
    opacity: 0.8;
  }
  /* الحروف محصورة في منطقة البرج ولا تدخل عمود النص */
  .hero__canvas { position: absolute; top: -18%; bottom: -6%; left: -14%; right: -4%; width: 118%; height: 124%; z-index: 0; pointer-events: none; }
  .hero__grid { position: relative; z-index: 1; display: grid; gap: 1.5rem; align-items: center; }
  .hero__text { display: grid; gap: 1.25rem; justify-items: start; order: 2; }
  .hero__art { position: relative; order: 1; width: min(78vw, 340px); margin-inline: auto; perspective: 1000px; }
  .hero__tilt { position: relative; z-index: 1; }
  .hero__tilt { transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transform-style: preserve-3d; will-change: transform; }

  .hero__badge {
    display: inline-flex;
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-dark);
    background: rgba(244, 239, 228, 0.06);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--on-dark-muted);
    animation: rise 0.9s var(--ease-expo) 0.05s both;
  }
  .hero__title {
    font-size: var(--fs-display);
    line-height: 1.3;
    color: var(--on-dark);
    text-wrap: balance;
  }
  .hero__line { display: block; }
  .w { display: inline-block; overflow: clip; overflow-clip-margin: 0.25em; padding-bottom: 0.08em; vertical-align: top; }
  .w__in {
    display: inline-block;
    animation: word-up 1.2s var(--ease-expo) both;
    animation-delay: calc(0.15s + var(--d) * 0.07s);
  }
  .w + .w { margin-inline-start: 0.24em; }
  .hero__lead {
    font-size: var(--fs-lead);
    line-height: 1.9;
    color: var(--on-dark-muted);
    max-width: 56ch;
    animation: rise 1s var(--ease-expo) 0.6s both;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; animation: rise 1s var(--ease-expo) 0.75s both; }
  .hero__actions .btn--outline { --btn-fg: var(--on-dark); --btn-bd: rgba(244, 239, 228, 0.45); }
  .hero__actions .btn--outline:hover { --btn-bg: var(--on-dark); --btn-fg: var(--indigo-900); }
  .hero__trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    animation: rise 1s var(--ease-expo) 0.9s both;
  }
  .hero__trust :global(svg) { color: var(--brick-400); }
  @keyframes word-up { from { transform: translateY(105%); } }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  .hero__scroll {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.25rem 0.75rem;
    font-size: var(--fs-xs);
    color: var(--on-dark-muted);
    text-decoration: none;
    animation: rise 1s var(--ease-expo) 1.8s both;
  }
  .hero__scroll i { display: block; width: 1px; height: 34px; background: linear-gradient(var(--on-dark-muted), transparent); position: relative; overflow: hidden; }
  .hero__scroll i::after { content: ''; position: absolute; inset: 0; background: var(--brick-400); animation: scroll-cue 2.2s var(--ease-in-out) 2.4s infinite; transform: translateY(-100%); }
  @keyframes scroll-cue { 60%, 100% { transform: translateY(100%); } }

  @media (max-width: 480px) {
    .hero__actions { width: 100%; }
    .hero__actions .btn { width: 100%; }
    .hero__trust { font-size: var(--fs-xs); }
  }
  @media (min-width: 1024px) {
    .hero { padding-bottom: 4rem; }
    .hero__grid { grid-template-columns: minmax(0, 1fr) clamp(460px, 40vw, 600px); gap: 3rem; }
    .hero__title { font-size: clamp(48px, 4.6vw, 80px); line-height: 1.28; }
    .hero__text { order: 1; gap: 1.5rem; }
    .hero__art { order: 2; width: 100%; max-width: 600px; }
  }
</style>

<script is:inline>
  // ضمان: إن لم يبدأ مشهد الحروف خلال 2.5 ثانية يُبنى البرج وحده
  setTimeout(function () { var z = document.querySelector('.zig--deferred'); if (z) z.classList.add('is-go'); }, 2500);
</script>

<script>
  import { initTongues } from '@/scripts/tongues';
  import { whenIdle } from '@/scripts/idle';
  whenIdle(initTongues, 400);
</script>

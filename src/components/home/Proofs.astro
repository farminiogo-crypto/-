---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import BeforeAfter from '@/components/proofs/BeforeAfter.astro';
import StatsDemo from '@/components/proofs/StatsDemo.astro';
import CitationCheck from '@/components/proofs/CitationCheck.astro';
import ContractCard from '@/components/proofs/ContractCard.astro';
---
<section class="section proofs" aria-labelledby="proofs-title">
  <div class="container">
    <SectionTitle
      id="proofs-title"
      eyebrow="لماذا بابل؟"
      title="لا نطلب منك أن تصدقنا. جرّب بنفسك."
      lead="أربعة أشياء نعدك بها، وتستطيع أن تراها هنا قبل أن تراسلنا."
    />
    <p class="proofs__hint" aria-hidden="true">اسحب لترى الإثباتات الأربعة ←</p>
    <div class="proofs__grid" data-proofs>
      <article class="proof card" data-reveal="rise">
        <header class="proof__head">
          <span class="proof__num">٠١</span>
          <h3>تنسيق عربي بلا أخطاء</h3>
          <p class="muted">اسحب الشريط وقارن: هكذا تصلنا الصفحات عادة، وهكذا تخرج من عندنا.</p>
        </header>
        <BeforeAfter />
      </article>
      <article class="proof card" data-reveal="rise">
        <header class="proof__head">
          <span class="proof__num">٠٢</span>
          <h3>إحصاء مشروح</h3>
          <p class="muted">هكذا تستلم كل جدول: الرقم، ومعناه، وكيف تناقشه.</p>
        </header>
        <StatsDemo />
      </article>
      <article class="proof card" data-reveal="rise">
        <header class="proof__head">
          <span class="proof__num">٠٣</span>
          <h3>مراجع حقيقية</h3>
          <p class="muted">في زمن الذكاء الاصطناعي، المراجع الوهمية تُسقط الرسائل. نحن نفحص كل مرجع.</p>
        </header>
        <CitationCheck />
      </article>
      <article class="proof card" data-reveal="rise">
        <header class="proof__head">
          <span class="proof__num">٠٤</span>
          <h3>سرية ووضوح</h3>
          <p class="muted">قبل أن تدفع شيئًا، تعرف ماذا ستستلم، ومتى، وكم مرة يمكنك طلب التعديل.</p>
        </header>
        <ContractCard />
      </article>
    </div>
    <div class="proofs__dots" aria-hidden="true" data-proofs-dots><i class="is-on"></i><i></i><i></i><i></i></div>
  </div>
</section>

<style>
  .proofs__grid { display: grid; gap: 1.25rem; }
  .proof { padding: 1.25rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .proof__head { display: grid; gap: 0.35rem; }
  .proof__num { font-family: var(--font-display); font-weight: 700; color: var(--brick-600); font-size: 1.1rem; }
  .proof__head h3 { font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.7rem); }
  .proof__head p { font-size: var(--fs-small); line-height: 1.75; }
  .proofs__hint, .proofs__dots { display: none; }
  /* الموبايل: الإثباتات الأربعة في شريط أفقي بدل عمود طويل */
  @media (max-width: 719px) {
    .proofs__hint { display: block; font-size: var(--fs-small); color: var(--ink-muted); margin: -0.5rem 0 0.9rem; }
    .proofs__grid {
      display: flex; align-items: flex-start; gap: 0.85rem; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 0.25rem var(--gutter) 0.75rem;
      scroll-padding-inline: var(--gutter);
    }
    .proofs__grid::-webkit-scrollbar { display: none; }
    .proof { flex: 0 0 88%; scroll-snap-align: start; }
    .proofs__dots { display: flex; justify-content: center; gap: 0.4rem; margin-top: 0.5rem; }
    .proofs__dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(44, 26, 69, 0.2); transition: width 0.3s, background-color 0.3s; }
    .proofs__dots i.is-on { width: 22px; border-radius: 4px; background: var(--brick-600); }
  }
  @media (min-width: 900px) {
    .proofs__grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .proof { padding: 1.75rem; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-proofs]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-proofs-dots] i')];
  if (track && dots.length) {
    const cards = [...track.children] as HTMLElement[];
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.intersectionRatio > 0.6) {
          const i = cards.indexOf(e.target as HTMLElement);
          dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
        }
      }
    }, { root: track, threshold: [0.6] });
    cards.forEach((c) => io.observe(c));
  }
</script>

---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
// نسخة مصغرة من معالج الطلب: خطوتان هنا، والباقي في /request/ (يعمل بدون JS لأنه نموذج GET عادي)
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const stages = ['بكالوريوس', 'ماجستير', 'دكتوراه', 'باحث', 'أخرى'];
---
<section class="section section--cream50 mini" aria-labelledby="mini-title">
  <div class="container">
    <form class="mini__card" action="/request/" method="get">
      <div class="mini__head">
        <p class="eyebrow">ابدأ من هنا</p>
        <h2 id="mini-title" data-reveal="heading">أين وصلت في رسالتك؟</h2>
        <p class="muted">اختر مرحلتك وما تحتاجه، ونكمل الباقي في صفحة الطلب.</p>
      </div>
      <fieldset class="mini__set">
        <legend>المرحلة</legend>
        <div class="mini__opts">
          {stages.map((s, i) => (
            <label class="mini__opt"><input type="radio" name="stage" value={s} checked={i === 1} /><span>{s}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="mini__set">
        <legend>الخدمة <span class="mini__hint">(يمكن اختيار أكثر من واحدة)</span></legend>
        <div class="mini__opts">
          {services.map((s) => (
            <label class="mini__opt"><input type="checkbox" name="service" value={s.id} /><span><Icon name={s.data.icon} size={16} /> {s.data.title}</span></label>
          ))}
        </div>
      </fieldset>
      <button class="btn btn--primary btn--lg mini__go" type="submit" data-magnetic>أكمل طلبك <Icon name="arrow-left" size={18} /></button>
    </form>
  </div>
</section>

<style>
  .mini { padding-top: 0; }
  .mini__card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: calc(var(--radius-card) + 8px);
    background: var(--cream-50);
    border: 1px solid var(--line-light);
    box-shadow: var(--shadow-2);
  }
  .mini__head { display: grid; gap: 0.6rem; }
  .mini__set { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: 0.75rem; }
  .mini__set legend { font-weight: 600; color: var(--indigo-900); padding: 0; margin-bottom: 0.75rem; }
  .mini__hint { font-weight: 400; color: var(--ink-muted); font-size: var(--fs-small); }
  .mini__opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mini__opt { position: relative; cursor: pointer; }
  .mini__opt input { position: absolute; opacity: 0; inset: 0; pointer-events: none; }
  .mini__opt span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line-light);
    background: var(--cream-100);
    font-weight: 500;
    color: var(--indigo-900);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .mini__opt span :global(svg) { color: var(--brick-600); }
  .mini__opt:hover span { border-color: rgba(44, 26, 69, 0.45); }
  .mini__opt input:focus-visible + span { outline: 2px solid var(--brick-600); outline-offset: 3px; }
  .mini__opt input:checked + span { background: var(--indigo-900); border-color: var(--indigo-900); color: var(--cream-100); }
  .mini__opt input:checked + span :global(svg) { color: var(--brick-400); }
  .mini__go { justify-self: start; }
  @media (max-width: 480px) { .mini__go { width: 100%; } }
</style>

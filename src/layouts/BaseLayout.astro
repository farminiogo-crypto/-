---
import '@/styles/tokens.css';
import '@/styles/base.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFab from '@/components/layout/WhatsAppFab.astro';
import Motion from '@/components/layout/Motion.astro';
import Analytics from '@/components/layout/Analytics.astro';
import { site, siteUrl } from '@/config/site';

interface Props {
  title: string; // عنوان الصفحة بدون اسم الموقع
  description?: string;
  fullTitle?: boolean; // إن كان العنوان كاملًا لا يضاف اسم الموقع
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  motion?: boolean; // تحميل GSAP وLenis
  headerTone?: 'dark' | 'light'; // لون الخلفية تحت الهيدر في أعلى الصفحة
  preloader?: boolean;
  preloadHeading?: boolean;
  fab?: boolean; // زر واتساب العائم (يُخفى في صفحات النماذج حتى لا يغطي الحقول)
}

const {
  title,
  description = site.description,
  fullTitle = false,
  ogImage = '/og/default.png',
  noindex = false,
  jsonLd,
  motion = true,
  headerTone = 'dark',
  preloader = false,
  preloadHeading = false,
  fab = true,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.nameAr}`;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : null;
const ogImageUrl = siteUrl ? new URL(ogImage, siteUrl).href : ogImage;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.nameAr,
  alternateName: site.nameEn,
  ...(site.legalEntity ? { legalName: site.legalEntity } : {}),
  description: site.description,
  ...(siteUrl ? { url: siteUrl, logo: `${siteUrl}/brand/logo.svg` } : {}),
  areaServed: { '@type': 'Country', name: 'المملكة العربية السعودية' },
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'SA' },
  telephone: `+${site.whatsapp}`,
  ...(site.email ? { email: site.email } : {}),
  sameAs: Object.values(site.social).filter(Boolean),
};
const ldList = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#2C1A45" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content={site.nameAr} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    {preloadHeading && <link rel="preload" href="/fonts/amiri-700.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/plex-400.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
      })();
    </script>
    {preloader && (
      <script is:inline>
        (function () {
          try {
            if (document.documentElement.classList.contains('rm')) return;
            if (sessionStorage.getItem('babel-intro')) return;
            sessionStorage.setItem('babel-intro', '1');
            var d = document.documentElement;
            d.classList.add('intro');
            // إن جهز الموقع بسرعة (قبل ظهور الشاشة) نتخطاها كليًا
            window.addEventListener('DOMContentLoaded', function () {
              if (performance.now() < 280) d.classList.remove('intro');
            });
            setTimeout(function () { d.classList.remove('intro'); }, 1000);
          } catch (e) {}
        })();
      </script>
    )}

    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">تخطَّ إلى المحتوى</a>
    {preloader && (
      <div class="intro-screen" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="84" height="84">
          <rect class="it it1" x="2" y="30" width="36" height="7" rx="1" />
          <rect class="it it2" x="7" y="22.5" width="26" height="7" rx="1" />
          <rect class="it it3" x="11.5" y="15" width="17" height="7" rx="1" />
          <rect class="it it4" x="15.5" y="7.5" width="9" height="7" rx="1" />
          <rect class="it-stair" x="18" y="7.5" width="4" height="29.5" />
        </svg>
      </div>
    )}
    <Header tone={headerTone} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {fab && <WhatsAppFab />}
    {motion && <Motion />}
    <Analytics />
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  .intro-screen { display: none; }
  .intro .intro-screen {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--indigo-950);
    color: var(--on-dark);
    animation: intro-in 0.2s linear both, intro-out 0.32s var(--ease-in-out) 0.62s forwards;
  }
  @keyframes intro-in { from { opacity: 0; } }
  .intro .intro-screen svg { animation: intro-rise 0.32s var(--ease-in-out) 0.58s forwards; }
  .intro-screen .it {
    fill: var(--cream-100);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scaleY(0);
    animation: intro-tier 0.28s var(--ease-out) forwards;
  }
  .intro-screen .it1 { animation-delay: 0.05s; }
  .intro-screen .it2 { animation-delay: 0.14s; }
  .intro-screen .it3 { animation-delay: 0.23s; }
  .intro-screen .it4 { animation-delay: 0.32s; }
  .intro-screen .it-stair {
    fill: var(--brick-600);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scaleY(0);
    animation: intro-tier 0.26s var(--ease-out) 0.4s forwards;
  }
  @keyframes intro-tier { to { transform: scaleY(1); } }
  @keyframes intro-rise { to { transform: translateY(-38vh) scale(0.45); opacity: 0; } }
  @keyframes intro-out { to { opacity: 0; visibility: hidden; } }
</style>
